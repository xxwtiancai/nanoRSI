# nanoRSI faithful Harness2 run: GLM-5.3 through OpenCode's openai-compatible provider.
# Provider definition lives in the isolated XDG config (.omx/xdg-config/opencode/opencode.json);
# export XDG_CONFIG_HOME to that directory before every harness2 command.
HARNESS2_SOLVER_MODEL=zai/glm-5.3
HARNESS2_IMPROVER_MODEL=zai/glm-5.3
HARNESS2_JUDGE_MODEL=custom/glm-5.3
# LAB judge (harvey-labs evaluation.judge, local custom/ provider patch) reads these:
OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# OPENAI_API_KEY is exported in the shell from ~/.nanorsi/keys/glm-coding-plan.key, never written here.
