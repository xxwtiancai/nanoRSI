#!/bin/sh
# Repo-managed secret guard for nanoRSI. Activate once per clone:
#   git config core.hooksPath .githooks
# Blocks any commit whose staged additions contain the local API key value,
# or that tries to stage the local-only AGENTS.md instructions file.
# The key itself lives only in ~/.nanorsi/keys/glm-coding-plan.key, outside any repo.
set -u

blocked=0

if git diff --cached --name-only --diff-filter=ACMR | grep -qx "AGENTS.md"; then
  echo "pre-commit: AGENTS.md is local-only (.gitignore). Unstage it." >&2
  blocked=1
fi

KEY_FILE="$HOME/.nanorsi/keys/glm-coding-plan.key"
if [ -s "$KEY_FILE" ]; then
  KEY=$(cat "$KEY_FILE")
  if [ -n "$KEY" ] && git diff --cached --no-color | grep '^+' | grep -qF -- "$KEY"; then
    echo "pre-commit: staged additions contain the local API key value. Commit blocked;" >&2
    echo "the secret belongs only in $KEY_FILE (outside this repository)." >&2
    blocked=1
  fi
fi

exit "$blocked"
